{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MedievalLeaderboard": {
    "DatabasePath": "App_Data/medieval-leaderboard.db"
  },
  "ImageGeneration": {
    "DefaultModel": "gpt-image-1.5",
    "Models": {
      "gpt-image-1.5": {
        "Provider": "AzureOpenAI",
        "DeploymentName": "gpt-image-1.5"
      },
      "mai-image-flash": {
        "Provider": "Mai",
        "DeploymentName": "MAI-Image-2.5-Flash"
      }
    },
    "Features": {
      "Sports": "gpt-image-1.5",
      "Jurassic": "gpt-image-1.5",
      "Medieval": "mai-image-flash"
    }
  }
}
