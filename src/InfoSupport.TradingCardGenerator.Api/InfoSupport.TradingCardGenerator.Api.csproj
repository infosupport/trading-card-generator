<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>SKEXP0010;SKEXP0001;OPENAI001</NoWarn>
    <UserSecretsId>2b737a48-bf4d-42a3-91af-9ee1d65a4a12</UserSecretsId>
  </PropertyGroup>

  <!-- Restore with lock file -->
  <PropertyGroup>
    <DisableImplicitNuGetFallbackFolder>true</DisableImplicitNuGetFallbackFolder>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.8.0-beta.1" />
    <PackageReference Include="Azure.Identity" Version="1.17.1" />
    <PackageReference Include="Handlebars.Net" Version="2.1.6" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.71.0" />
    <PackageReference Include="Microsoft.SemanticKernel.PromptTemplates.Handlebars" Version="1.71.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Prompts\generate-photo.md" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InfoSupport.TradingCardGenerator.ServiceDefaults\InfoSupport.TradingCardGenerator.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Features\Sports\Prompts\*.md" />
    <EmbeddedResource Include="Features\Jurassic\Prompts\*.md" />
    <EmbeddedResource Include="Features\Medieval\Prompts\*.md" />
    <EmbeddedResource Include="Features\Isks\Prompts\*.md" />
    <EmbeddedResource Include="Features\Isks8Bit\Prompts\*.md" />
  </ItemGroup>

</Project>
